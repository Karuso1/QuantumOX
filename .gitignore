# ===== QuantumOX C++ Project =====

# Build artifacts
*.o
*.obj
*.a
*.so
*.dll
*.dylib
*.out
*.exe

# Build directories
/bin/
/build/
/obj/
/dist/

# Makefile backups or intermediates
*.d
*.depend
*.make

# Temporary or cache files
*.tmp
*.log
*.cache
*.swp
*.swo

# Compiler outputs
*.gch
*.pch

# OS-specific junk
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Editor / IDE folders
.vscode/
.idea/
*.code-workspace

# Backup / Autosave
*~
*.bak
*.old

# Python or script caches (if any)
__pycache__/
*.pyc

# ===== QuantumOX Specific =====

# Ignore compiled engine outputs
src/QuantumOX
src/QuantumOX.exe
src/engine.out

# Ignore generated test or data files
/tests/output/
*.dat
*.bin

# ===== Scripts =====
# Keep scripts, but ignore temp runtime outputs
scripts/*.log
scripts/*.tmp
